{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bnb-guardian-monitor",
  "main": "src/worker.js",
  "account_id": "7f65a6a47b0fc5bdce2cf02f2e1205b9",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
    "CAMPAIGN_WALLET": "0x9F81A9588c310b90A0636E8D2fb31523a57fbaDC",
    "PUBLIC_BASE_URL": "https://bnb-guardian.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "MONITOR_DB",
      "database_name": "bnb-guardian-monitor",
      "database_id": "eeadc0e5-5e6c-4a10-bd7a-e038557d8db6",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "10097",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
